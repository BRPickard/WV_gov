# Required. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me

# The exact origin the app is served from. Requests arriving with a different
# Origin header are rejected, so this must match your deployment URL.
BETTER_AUTH_URL=http://localhost:3000

# Optional: extra origins allowed to call the auth API (comma separated).
# TRUSTED_ORIGINS=https://library.example.gov

# Optional: where the SQLite database and stored .xlsx files live.
# DATA_DIR=./data

# Optional: password used by `npm run seed` for the demo accounts.
# SEED_PASSWORD=ChangeMe!2026
